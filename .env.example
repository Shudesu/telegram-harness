# Telegram Harness — names and local placeholders only.
# Copy to .env for local dev. Never commit real tokens, keys, or chat secrets.
# Worker secrets are set by name with `wrangler secret put <NAME>` and are not deployed by this repo.

# Bearer token for the management API and the Next.js server (server-side only).
API_KEY=replace-with-local-api-key

# Optional separate bearer for POST /api/intake/drafts. Falls back to API_KEY when unset.
INTAKE_API_KEY=replace-with-local-intake-key

# Compared with the X-Telegram-Bot-Api-Secret-Token header. 1-256 chars: A-Z a-z 0-9 _ -
TELEGRAM_WEBHOOK_SECRET=replace-with-webhook-secret

# Referenced by tokenEnvName when registering a bot. The value stays in the environment.
TELEGRAM_BOT_TOKEN_MAIN=replace-with-bot-token-from-botfather

# Live Bot API calls stay off unless this is the string true. Default is false.
# The dry-run node server refuses to start when this is true.
# user-live may set it so Bot API sends use the same SQLite file as the account layer.
TELEGRAM_ALLOW_NETWORK=false

# GramJS user-account layer. Values below are names and placeholders.
# api_id and api_hash come from https://my.telegram.org for this owner only.
# The local node server refuses to start when TELEGRAM_USER_ALLOW_NETWORK is true.
TELEGRAM_API_ID=replace-with-api-id
TELEGRAM_API_HASH=replace-with-api-hash
TELEGRAM_SESSION_ENCRYPTION_KEY=replace-with-32-byte-base64url-key
TELEGRAM_USER_SESSION=replace-with-encrypted-session
TELEGRAM_USER_ALLOW_NETWORK=false

# Optional path for the encrypted secret file. Use .local/ (gitignored) or a path outside the repo.
# The file stores session ciphertext, login state, and TELEGRAM_BOT_TOKEN_* values written by the store.
# TELEGRAM_SECRET_STORE_PATH=.local/user-secrets.json

# SQLite file for `pnpm --filter worker user-live`. Default is outside the repo:
# ~/.local/share/telegram-harness/telegram-harness.sqlite
# Use .local/ or a path outside the repo. The file mode is 0600. The dry-run server does not open it.
# TELEGRAM_DB_PATH=.local/telegram-harness.sqlite

# user-live bind address. Default is 127.0.0.1. Management routes still require API_KEY.
# HOST=127.0.0.1
# PORT=8787

# MCP server and local web server. Not a secret URL.
TELEGRAM_HARNESS_API_URL=http://localhost:8787
TELEGRAM_HARNESS_API_KEY=replace-with-local-api-key

# Next.js server-side API origin. Do not prefix secrets with NEXT_PUBLIC_.
# API_KEY above is read only on the server.
