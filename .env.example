# Telegram Harness — names and local placeholders only.
# Copy to .env for local dev. Never commit real tokens, keys, or chat secrets.
# Worker secrets are set by name with `wrangler secret put <NAME>` and are not deployed by this repo.

# Bearer token for the management API and the Next.js server (server-side only).
API_KEY=replace-with-local-api-key

# Optional separate bearer for POST /api/intake/drafts. Falls back to API_KEY when unset.
INTAKE_API_KEY=replace-with-local-intake-key

# Compared with the X-Telegram-Bot-Api-Secret-Token header. 1-256 chars: A-Z a-z 0-9 _ -
TELEGRAM_WEBHOOK_SECRET=replace-with-webhook-secret

# Referenced by tokenEnvName when registering a bot. The value stays in the environment.
TELEGRAM_BOT_TOKEN_MAIN=replace-with-bot-token-from-botfather

# Live Bot API calls stay off unless this is the string true. Default is false.
# The local node server refuses to start when this is true.
TELEGRAM_ALLOW_NETWORK=false

# MCP server and local web server. Not a secret URL.
TELEGRAM_HARNESS_API_URL=http://localhost:8787
TELEGRAM_HARNESS_API_KEY=replace-with-local-api-key

# Next.js server-side API origin. Do not prefix secrets with NEXT_PUBLIC_.
# API_KEY above is read only on the server.
