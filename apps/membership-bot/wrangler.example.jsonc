// Copy to wrangler.jsonc and adjust. No account id or resource ids are needed here:
// wrangler uses the account you are logged in to, and the Durable Object is created on first deploy.
{
  "name": "telegram-harness",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "assets": {
    "directory": "./assets",
    "binding": "ASSETS",
    // The Worker owns every route; the headers and collages are reachable only through the binding.
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [{ "name": "CHAT", "class_name": "ChatSession" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChatSession"] }],
  // Membership sweep (expiry / grace / verification time-out). A no-op while MEMBERSHIP != "1".
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    // "1" turns the paid membership feature on.
    "MEMBERSHIP": "0",
    // "1" makes the Mini App create REAL Telegram Stars invoices. Leave "0" (TEST) until /terms and
    // /paysupport show your real seller details (see README: Stars payments).
    "PAY_LIVE": "0",
    "BOT_USERNAME": "your_bot"
  }
}
