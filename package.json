{
  "name": "telegram-harness",
  "version": "0.2.0",
  "private": true,
  "description": "Telegram Harness — Bot API publishing and an owner-account GramJS layer, both approval-gated",
  "license": "MIT",
  "author": {
    "name": "野田修一 (Shudesu)",
    "url": "https://the-harness.com/noda-shuichi/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shudesu/telegram-harness.git"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev:worker": "pnpm --filter worker dev",
    "dev:web": "pnpm --filter web dev",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "check:secrets": "node scripts/check-no-secrets.mjs",
    "check": "pnpm check:secrets && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.32",
      "tinypool": "^2.2.0"
    }
  }
}
