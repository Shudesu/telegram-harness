{
  "name": "telegram-harness",
  "version": "0.3.2",
  "private": true,
  "description": "Telegram Harness — Bot API publishing, an owner-account GramJS layer, and a membership / Stars / booking bot",
  "license": "MIT",
  "author": {
    "name": "野田修一 (Shudesu)",
    "url": "https://the-harness.com/noda-shuichi/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shudesu/telegram-harness.git"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev:worker": "pnpm --filter worker dev",
    "dev:web": "pnpm --filter web dev",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "check:secrets": "node scripts/check-no-secrets.mjs",
    "check": "pnpm check:secrets && pnpm typecheck && pnpm test && pnpm test:membership-bot && pnpm build:membership-bot",
    "dev:membership-bot": "pnpm --filter membership-bot exec wrangler dev",
    "test:membership-bot": "pnpm --filter membership-bot test",
    "build:membership-bot": "pnpm --filter membership-bot build"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
